name: matrix-telegram-wsproxy
services:
  wsproxy:
    image: {{ telegram_wsproxy_image }}
    container_name: {{ telegram_wsproxy_container_name }}
    restart: unless-stopped
    env_file: .env
    networks:
      - {{ telegram_wsproxy_synapse_network }}
      - {{ telegram_traefik_network }}
    labels:
      traefik.enable: "true"
      traefik.docker.network: {{ telegram_traefik_network }}
      traefik.http.routers.matrix-telegram-wsproxy.rule: Host(`{{ telegram_homeserver_hostname }}`) && Path(`{{ telegram_wsproxy_path }}`)
      traefik.http.routers.matrix-telegram-wsproxy.priority: "1000"
      traefik.http.routers.matrix-telegram-wsproxy.entrypoints: {{ telegram_traefik_entrypoint }}
      traefik.http.routers.matrix-telegram-wsproxy.tls: "true"
      traefik.http.routers.matrix-telegram-wsproxy.tls.certResolver: {{ telegram_traefik_cert_resolver }}
      traefik.http.routers.matrix-telegram-wsproxy.service: matrix-telegram-wsproxy
      traefik.http.services.matrix-telegram-wsproxy.loadbalancer.server.port: "{{ telegram_wsproxy_port }}"
networks:
  {{ telegram_wsproxy_synapse_network }}:
    external: true
  {{ telegram_traefik_network }}:
    external: true
