name: matrix-telegram-media
services:
  tunnel:
    image: {{ telegram_chisel_image }}
    container_name: matrix-telegram-media-tunnel
    restart: unless-stopped
    command: ["server", "--port", "8080", "--reverse", "--auth", "${CHISEL_AUTH}"]
    networks:
      - media-internal
      - {{ telegram_traefik_network }}
    labels:
      traefik.enable: "true"
      traefik.docker.network: {{ telegram_traefik_network }}
      traefik.http.routers.matrix-telegram-media-tunnel.rule: Host(`{{ telegram_media_hostname }}`) && HeaderRegexp(`Upgrade`, `(?i)websocket`)
      traefik.http.routers.matrix-telegram-media-tunnel.priority: "1000"
      traefik.http.routers.matrix-telegram-media-tunnel.entrypoints: {{ telegram_traefik_entrypoint }}
      traefik.http.routers.matrix-telegram-media-tunnel.tls: "true"
      traefik.http.routers.matrix-telegram-media-tunnel.tls.certResolver: {{ telegram_traefik_cert_resolver }}
      traefik.http.routers.matrix-telegram-media-tunnel.service: matrix-telegram-media-tunnel
      traefik.http.services.matrix-telegram-media-tunnel.loadbalancer.server.port: "8080"
  proxy:
    image: {{ telegram_socat_image }}
    container_name: matrix-telegram-media
    restart: unless-stopped
    depends_on:
      - tunnel
    command: ["tcp-listen:29317,fork,reuseaddr", "tcp-connect:tunnel:29318"]
    networks:
      - media-internal
      - {{ telegram_traefik_network }}
    labels:
      traefik.enable: "true"
      traefik.docker.network: {{ telegram_traefik_network }}
      traefik.http.routers.matrix-telegram-media.rule: Host(`{{ telegram_media_hostname }}`)
      traefik.http.routers.matrix-telegram-media.entrypoints: {{ telegram_traefik_entrypoint }}
      traefik.http.routers.matrix-telegram-media.tls: "true"
      traefik.http.routers.matrix-telegram-media.tls.certResolver: {{ telegram_traefik_cert_resolver }}
      traefik.http.routers.matrix-telegram-media.middlewares: matrix-telegram-media-strip-auth
      traefik.http.routers.matrix-telegram-media.service: matrix-telegram-media
      traefik.http.middlewares.matrix-telegram-media-strip-auth.headers.customRequestHeaders.Authorization: ""
      traefik.http.services.matrix-telegram-media.loadbalancer.server.port: "29317"
networks:
  media-internal:
    internal: true
  {{ telegram_traefik_network }}:
    external: true
